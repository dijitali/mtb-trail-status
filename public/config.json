{
  "pageTitle": "PCBC Interactive Trail Map",
  "mapDefaults": {
    "zoom": 13,
    "center": [175.029, -36.931],
    "rotation": -90,
    "padding": [50, 50, 50, 50],
    "duration": 1000
  },
  "gradingSystem": {
    "1": { "name": "Easiest", "color": "#2ca02c", "className": "grade-1" },
    "2": { "name": "Easy", "color": "#1f77b4", "className": "grade-2" },
    "3": { "name": "Intermediate", "color": "#ff7f0e", "className": "grade-3" },
    "4": { "name": "Advanced", "color": "#d62728", "className": "grade-4" },
    "5": { "name": "Expert", "color": "#9467bd", "className": "grade-5" },
    "6": { "name": "Extreme", "color": "#000000", "className": "grade-6" },
    "default": { "name": "Unknown", "color": "#777777", "className": "grade-unknown" }
  },
  "apiUrls": {
    "overpass": "https://overpass-api.de/api/interpreter"
  },
  "dataFiles": {
    "trailsCsv": "/trails.csv"
  },
  "trailDefaults": {
    "name": "Unnamed Trail",
    "status": "Unknown",
    "comments": "",
    "grade": "1"
  },
  "trailLineStyles": {
    "lineWidth": 4,
    "statusColors": {
      "open": "green",
      "closed": "red",
      "unknown": "grey"
    }
  },
  "trailLabelStyles": {
    "font": "bold 12px Arial",
    "strokeColor": "white",
    "strokeWidth": 3,
    "placement": "line",
    "overflow": true,
    "offsetY": 0
  },
  "uiMessages": {
    "loadingElementId": "loading",
    "initialLoading": "Loading trail data...",
    "noDataInCsv": "No trail data found in the CSV file."
  },
  "popup": {
    "statusClasses": {
      "open": "trail-open",
      "closed": "trail-closed",
      "unknown": "trail-unknown"
    }
  }
}
